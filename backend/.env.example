# Modo do provedor:
#   auto       -> usa OpenChamber/OpenCode (sem API key) se nao houver NVIDIA_API_KEY, ou NVIDIA NIM API se a chave estiver preenchida
#   opencode   -> forca uso do OpenChamber / OpenCode CLI (console-nvidia, sem API key)
#   nvidia_api -> forca uso direto da API NVIDIA NIM (requer NVIDIA_API_KEY)
PROVIDER_MODE=auto

# OpenChamber / OpenCode CLI (usado automaticamente quando NVIDIA_API_KEY esta vazia)
OPENCODE_CLI_PATH=
OPENCODE_PROVIDER_PREFIX=console-nvidia
OPENCODE_USE_STANDALONE=true

# Opcional: chave direta da API NVIDIA NIM (desnecessaria se voce usa o console-nvidia pelo OpenChamber)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

DATABASE_URL=sqlite:///./modelarena.db
REQUEST_TIMEOUT_SECONDS=120
MAX_CONCURRENCY=1
NVIDIA_MAX_RETRIES=2
NVIDIA_MAX_TOKENS=2048
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8765,http://127.0.0.1:8765
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
